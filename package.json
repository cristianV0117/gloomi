{
  "name": "gloomi-monorepo",
  "private": true,
  "description": "GLOOMI · frontend (Vite/React) + backend (NestJS)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:tunnel": "npm --prefix frontend run dev:tunnel",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "start:backend": "npm --prefix backend run start",
    "start:backend:dev": "npm --prefix backend run start:dev"
  }
}
