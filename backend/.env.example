# Copia a .env y ajusta. En Railway define la variable en el servicio (sin commitear secretos).
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/gloomi

# Orígenes permitidos para CORS (SPA). Producción: URL pública del front en Railway, separadas por coma.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gloomi-production.up.railway.app

# MongoDB Atlas (ejemplo):
# MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/gloomi?retryWrites=true&w=majority
